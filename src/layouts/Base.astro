---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";

interface Story {
  title: string;
  summary: string | string[];
  url: string;
  source: string;
  tag: string;
  significance: number;
}

interface Props {
  title: string;
  description?: string;
  digestDate?: string;
  stories?: Story[];
  extraSchema?: unknown[];
}

const { title, description = "Top 5 developer-centric AI stories, curated daily.", digestDate, stories, extraSchema } = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;

// NewsArticle only on the permanent /digest/YYYY-MM-DD route — never on the homepage,
// which would create a URL-vs-canonical mismatch (canonical is "/", schema would point to /digest/).
const isDigestRoute = Astro.url.pathname.startsWith("/digest/");
const isArticle = Boolean(isDigestRoute && digestDate && stories?.length);
const digestUrl = digestDate ? new URL(`/digest/${digestDate}/`, Astro.site ?? "https://www.ai-daily.dev").toString() : undefined;
const publishedAt = digestDate ? `${digestDate}T08:00:00+01:00` : undefined;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "NewsMediaOrganization",
  "@id": "https://www.ai-daily.dev/#organization",
  "name": "AI Daily Dev",
  "url": "https://www.ai-daily.dev/",
  "logo": {
    "@type": "ImageObject",
    "url": "https://www.ai-daily.dev/favicon.svg",
    "width": 512,
    "height": 512,
  },
  "sameAs": ["https://github.com/tordar/ai-daily"],
  "founder": {
    "@type": "Person",
    "name": "Tordar Tømmervik",
    "url": "https://www.ai-daily.dev/about",
    "sameAs": ["https://github.com/tordar"],
  },
  "publishingPrinciples": "https://www.ai-daily.dev/about",
  "diversityPolicy": "https://www.ai-daily.dev/about",
  "ethicsPolicy": "https://www.ai-daily.dev/about",
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://www.ai-daily.dev/#website",
  "name": "AI Daily Dev",
  "url": Astro.site?.toString() ?? "",
  "description": "Top developer-centric AI stories, curated daily.",
  "inLanguage": "en",
  "publisher": { "@id": "https://www.ai-daily.dev/#organization" },
};

const itemListSchema = stories?.length ? {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": title,
  "itemListElement": stories.map((s, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": s.title,
    "url": s.url,
  })),
} : null;

const newsArticleSchema = isArticle && digestUrl && publishedAt ? {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": title,
  "description": description,
  "url": digestUrl,
  "mainEntityOfPage": { "@type": "WebPage", "@id": digestUrl },
  "datePublished": publishedAt,
  "dateModified": publishedAt,
  "image": [{
    "@type": "ImageObject",
    "url": `https://www.ai-daily.dev/og/${digestDate}.png`,
    "width": 1200,
    "height": 630,
  }],
  "publisher": { "@id": "https://www.ai-daily.dev/#organization" },
  "author": { "@id": "https://www.ai-daily.dev/#organization" },
  "contributor": {
    "@type": "SoftwareApplication",
    "name": "Claude",
    "applicationCategory": "AI",
    "url": "https://www.anthropic.com/claude",
  },
  "editor": {
    "@type": "Person",
    "name": "Tordar Tømmervik",
    "url": "https://www.ai-daily.dev/about",
    "sameAs": ["https://github.com/tordar"],
  },
  "articleSection": "AI",
  "isAccessibleForFree": true,
} : null;

const ogType = isArticle ? "article" : "website";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="AI Daily Dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    {digestDate && <meta property="og:image" content={`https://www.ai-daily.dev/og/${digestDate}.png`} />}
    {digestDate && <meta property="og:image:width" content="1200" />}
    {digestDate && <meta property="og:image:height" content="630" />}
    {isArticle && publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {isArticle && publishedAt && <meta property="article:modified_time" content={publishedAt} />}
    {isArticle && <meta property="article:author" content="Tordar Tømmervik" />}
    {isArticle && <meta property="article:section" content="AI" />}
    <meta name="twitter:card" content={digestDate ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {digestDate && <meta name="twitter:image" content={`https://www.ai-daily.dev/og/${digestDate}.png`} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="AI Daily Dev" href="/feed.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {itemListSchema && <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />}
    {newsArticleSchema && <script type="application/ld+json" set:html={JSON.stringify(newsArticleSchema)} />}
    {extraSchema?.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <ClientRouter />
    <script is:inline>
      function applyTheme() {
        var stored = localStorage.getItem('theme');
        var isLight = stored ? stored === 'light' : window.matchMedia('(prefers-color-scheme: light)').matches;
        document.documentElement.classList.toggle('light', isLight);
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body data-digest-date={digestDate}>
    <div class="max-w-[860px] mx-auto">
      <slot />
    </div>
    <script src="../scripts/keyboard.ts"></script>
    <Analytics />
  </body>
</html>
